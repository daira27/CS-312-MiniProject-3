<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Blog</title>
  <link rel="stylesheet" href="/styles.css">
</head>

<body>

  <header class="site-header">
    <h1>My Little Blog </h1>
    <p>A cozy corner for stories, ideas, and inspiration.</p>
  </header>

  <% if (user) { %>
    <p>Welcome, <%= user.name %>!</p>

    <form action="/logout" method="POST">
        <button type="submit">Log Out</button>
    </form>
  <% } else { %>
    <a href="/signin">Sign In</a>
    <a href="/signup">Sign Up</a>
  <% } %>


  <!-- step 3: post creation -->
  <!-- form for new blog post -->
  
  <% if (user) { %>

    <h2>Create a New Post</h2>

    <form action="/posts" method="POST">

        <label for="title">Title:</label>
        <input
            type="text"
            id="title"
            name="title"
            required
        >

        <br><br>

        <label for="content">Blog:</label>
        <br>

        <textarea
            id="content"
            name="content"
            rows="8"
            cols="50"
            required
        ></textarea>

        <br><br>

        <button type="submit">Create Post</button>

    </form>

  <% } else { %>

    <p>Please <a href="/signin">sign in</a> to create a blog post.</p>

  <% } %>


  <hr>

  <!-- step 4: post viewing -->
  <!-- displays blog posts -->
  <h2>Blog Posts</h2>

  <% posts.forEach(post => { %>

    <article>

      <h3><%= post.title %></h3>

      <p>
        By <%= post.creator %>
      </p>

      <p>
        <%= post.createdAt.toLocaleString() %>
      </p>

      <p>
        <%= post.content %>
      </p>

      
  <% if (user && user.user_id === post.creator_user_id) { %>

    <a href="/edit/<%= post.id %>">
        Edit
    </a>

    <form action="/delete/<%= post.id %>" method="POST">
        <button type="submit">Delete</button>
    </form>

  <% } %>


    </article>

    <hr>

  <% }) %>

</body>

</html>