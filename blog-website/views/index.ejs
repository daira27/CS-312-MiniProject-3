<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Blog</title>
  <link rel="stylesheet" href="/styles.css">
</head>

<body>

  <h1>My Blog Website</h1>

  <!-- step 3: post creation -->
  <!-- form for new blog post -->
  <h2>Create a New Post</h2>

  <form action="/posts" method="POST">

    <label for="creator">Name:</label>
    <input
      type="text"
      id="creator"
      name="creator"
      required
    >

    <br><br>

    <label for="title">Title:</label>
    <input
      type="text"
      id="title"
      name="title"
      required
    >

    <br><br>

    <label for="content">Blog:</label>
    <br>

    <textarea
      id="content"
      name="content"
      rows="8"
      cols="50"
      required
    ></textarea>

    <br><br>

    <button type="submit">Create Post</button>

  </form>


  <hr>

  <!-- step 4: post viewing -->
  <!-- displays blog posts -->
  <h2>Blog Posts</h2>

  <% posts.forEach(post => { %>

    <article>

      <h3><%= post.title %></h3>

      <p>
        By <%= post.creator %>
      </p>

      <p>
        <%= post.createdAt.toLocaleString() %>
      </p>

      <p>
        <%= post.content %>
      </p>

      <!--edit -->
      <a href="/edit/<%= post.id %>">
        Edit
      </a>

      <!--delete -->
      <form action="/delete/<%= post.id %>" method="POST">
        <button type="submit">Delete</button>
      </form>

    </article>

    <hr>

  <% }) %>

</body>

</html>