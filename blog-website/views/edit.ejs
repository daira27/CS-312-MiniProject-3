<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Post</title>
  <link rel="stylesheet" href="/styles.css">
</head>

<body>

  <h1>Edit Post</h1>

  <form action="/edit/<%= post.id %>" method="POST">

    <label for="creator">Name:</label>
    <input
      type="text"
      id="creator"
      name="creator"
      value="<%= post.creator %>"
      required
    >

    <br><br>

    <label for="title">Title:</label>
    <input
      type="text"
      id="title"
      name="title"
      value="<%= post.title %>"
      required
    >

    <br><br>

    <label for="content">Blog:</label>
    <br>

    <textarea
      id="content"
      name="content"
      rows="8"
      cols="50"
      required
    ><%= post.content %></textarea>

    <br><br>

    <button type="submit">Save Changes</button>

  </form>

  <br>

  <a href="/">Cancel</a>

</body>

</html>